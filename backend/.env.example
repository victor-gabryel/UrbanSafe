POSTGRES_DB=urbansafe
POSTGRES_USER=urbansafe
POSTGRES_PASSWORD=troque-esta-senha

DB_URL=jdbc:postgresql://localhost:5432/urbansafe
DB_USERNAME=urbansafe
DB_PASSWORD=troque-esta-senha

SERVER_PORT=8080

# E-mail (SMTP). Use uma senha de aplicativo própria; nunca versione valores reais.
MAIL_HOST=smtp.exemplo.com
MAIL_PORT=587
MAIL_USERNAME=seu-usuario
MAIL_PASSWORD=sua-senha-de-aplicativo
MAIL_FROM=no-reply@exemplo.com
# Opcionais: STARTTLS (padrão true) e timeout de conexão/leitura SMTP em ms (padrão 10000)
MAIL_STARTTLS=true
MAIL_TIMEOUT_MS=10000

# Frontend (também define a origem permitida no CORS)
FRONTEND_URL=http://localhost:3000

# JWT — obrigatório, mínimo 32 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=urbansafe-backend
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
PASSWORD_RESET_EXPIRATION_MINUTES=60

# Verificação de e-mail (valores padrão mostrados)
EMAIL_VERIFICATION_EXPIRATION_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_RESEND_MAX_PER_WINDOW=5
EMAIL_VERIFICATION_RESEND_WINDOW_MINUTES=15

# Swagger UI (http://localhost:8080/swagger-ui.html). Use false em produção.
SWAGGER_ENABLED=true
